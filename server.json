{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ArturLys/ao3-mcp",
  "description": "Search AO3 and have fics read by a secondary model before they're recommended",
  "repository": {
    "url": "https://github.com/ArturLys/ao3-mcp",
    "source": "github"
  },
  "version": "0.1.2",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "ao3-mcp",
      "version": "0.1.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GEMINI_API_KEY",
          "description": "Gemini API key (free from https://aistudio.google.com/api-keys)",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
